---
// Animated pixel-art scene for the Projects page's "more coming soon" card: the builder training a
// model on a huge GPU, with a coffee break (coderScene.ts). Drawn on the same dot grid as
// CoffeeCupGrid.astro. Static for reduced-motion visitors. Scenes are registered in SCENES below
// (another one, building a house, is parked in sandbox/builderScene.ts).
interface Props {
	scene?: "code";
}
const { scene = "code" } = Astro.props;
---

<canvas class="builder-grid" data-scene={scene} aria-hidden="true"></canvas>

<style>
	.builder-grid {
		display: block;
		width: 100%;
		height: 100%;
		background: #0f172a;
	}
</style>

<script>
	import * as code from "./coderScene";
	import type { Put } from "./sceneKit";

	// Each scene lays itself out for a size, then draws itself at any time on that layout
	type Scene<L> = {
		layoutScene(width: number, height: number): L;
		drawScene(layout: L, time: number, put: Put): void;
		stillTime(layout: L): number;
		MIN_WIDTH: number;
		MIN_HEIGHT: number;
	};
	const bind = <L,>(scene: Scene<L>) => {
		let layout: L | null = null;
		return {
			minWidth: scene.MIN_WIDTH,
			minHeight: scene.MIN_HEIGHT,
			layout: (width: number, height: number) => (layout = scene.layoutScene(width, height)),
			draw: (time: number, put: Put) => layout && scene.drawScene(layout, time, put),
			still: () => (layout ? scene.stillTime(layout) : 0),
		};
	};
	const SCENES = { code: () => bind(code) };

	// Grid look, matching CoffeeCupGrid.astro so the two cards feel like a set
	const CELL = 2; // px per grid cell
	const GAP = 1; // px between cells
	const COLOR = [56, 189, 248]; // #38bdf8, site accent
	const BG = [15, 23, 42]; // #0f172a, the canvas background
	const BASE_ALPHA = 0.07; // opacity of an unlit cell
	const FRAME_MS = 1000 / 60; // redraw at most 60 times a second, even on high-refresh screens

	// Opaque color of a dot at each opacity (accent over the background), packed as RGBA pixels
	const SHADES = (() => {
		const bytes = new Uint8ClampedArray(256 * 4);
		for (let k = 0; k < 256; k++) {
			const a = k / 255;
			bytes.set([BG[0] + (COLOR[0] - BG[0]) * a, BG[1] + (COLOR[1] - BG[1]) * a, BG[2] + (COLOR[2] - BG[2]) * a, 255], k * 4);
		}
		return new Uint32Array(bytes.buffer);
	})();
	// A lit cell is drawn over an unlit one, as CoffeeCupGrid draws the cup over its grid
	const dotColor = (v: number) => {
		const a = BASE_ALPHA + (1 - BASE_ALPHA) * v;
		return SHADES[((a + BASE_ALPHA * (1 - a)) * 255 + 0.5) | 0];
	};
	const UNLIT = SHADES[(BASE_ALPHA * 255 + 0.5) | 0];

	function mount(canvas: HTMLCanvasElement) {
		canvas.dataset.ready = "true";
		const scene = (SCENES[canvas.dataset.scene as keyof typeof SCENES] ?? SCENES.code)();
		const ctx = canvas.getContext("2d")!;
		const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

		// Each frame is built at one pixel per cell, scaled up, then cut into dots by `dots`, a mask
		// with every dot drawn exactly as CoffeeCupGrid draws them
		const cells = document.createElement("canvas");
		const cellCtx = cells.getContext("2d")!;
		const dots = document.createElement("canvas");
		let image = new ImageData(1, 1);
		let pixels = new Uint32Array(0); // view of image's pixels

		let dpr = 1;
		let cols = 0;
		let rows = 0;
		// The scene is laid out in art pixels; each covers scale x scale cells
		let scale = 2;
		let artW = 0;
		let artH = 0;
		let artX = 0;
		let artY = 0;
		let laidOut = false;
		let art = new Float32Array(0); // scene brightness per art pixel
		let sceneTime = 0;
		let lastFrame = 0; // when the last frame was drawn
		let lastTick = 0;
		let budget = 0; // ms owed toward the next frame
		let running = false;
		let visible = false;

		const resize = () => {
			dpr = window.devicePixelRatio || 1;
			const rect = canvas.getBoundingClientRect();
			canvas.width = Math.round(rect.width * dpr);
			canvas.height = Math.round(rect.height * dpr);
			cols = Math.ceil(rect.width / CELL);
			rows = Math.ceil(rect.height / CELL);
			if (!cols || !rows) return;

			// Largest whole-number scale the scene fits at keeps the art crisp; the leftover cells
			// go above the scene so the ground stays put
			scale = Math.max(1, Math.min(Math.floor(cols / scene.minWidth), Math.floor(rows / scene.minHeight)));
			artW = Math.floor(cols / scale);
			artH = Math.floor(rows / scale);
			artX = Math.floor((cols - artW * scale) / 2);
			artY = rows - artH * scale;
			scene.layout(artW, artH);
			laidOut = true;
			art = new Float32Array(artW * artH);

			cells.width = cols;
			cells.height = rows;
			image = cellCtx.createImageData(cols, rows);
			pixels = new Uint32Array(image.data.buffer);
			dots.width = canvas.width;
			dots.height = canvas.height;
			const dotCtx = dots.getContext("2d")!;
			dotCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
			dotCtx.fillStyle = "#fff";
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) dotCtx.fillRect(c * CELL + GAP / 2, r * CELL + GAP / 2, CELL - GAP, CELL - GAP);
			}

			if (reducedMotion) sceneTime = scene.still();
			draw();
		};

		const put = (x: number, y: number, v: number) => {
			if (x >= 0 && y >= 0 && x < artW && y < artH) art[y * artW + x] = v;
		};

		// Paint the scene at sceneTime, one block of cells per art pixel, and cut it into dots
		const draw = () => {
			if (!laidOut) return;
			art.fill(0);
			scene.draw(sceneTime, put);
			pixels.fill(UNLIT);
			for (let y = 0; y < artH; y++) {
				for (let x = 0; x < artW; x++) {
					const v = art[y * artW + x];
					if (!v) continue;
					const color = dotColor(v);
					const top = (artY + y * scale) * cols + artX + x * scale;
					for (let sy = 0; sy < scale; sy++) pixels.fill(color, top + sy * cols, top + sy * cols + scale);
				}
			}
			cellCtx.putImageData(image, 0, 0);
			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.imageSmoothingEnabled = false;
			ctx.globalCompositeOperation = "copy";
			ctx.drawImage(cells, 0, 0, cols * CELL * dpr, rows * CELL * dpr);
			ctx.globalCompositeOperation = "destination-in";
			ctx.drawImage(dots, 0, 0);
			ctx.globalCompositeOperation = "source-over";
		};

		const frame = (now: number) => {
			// Page navigated away: stop and let it be garbage collected
			if (!canvas.isConnected) {
				teardown();
				return;
			}
			// Scrolled off screen: pause until it's visible again
			if (!visible) {
				running = false;
				return;
			}
			requestAnimationFrame(frame);
			// Pace to 60fps on faster screens: owe each frame's time, draw once a frame's worth is due
			// (with a little slack so 60Hz screens never skip one)
			budget += now - lastTick;
			lastTick = now;
			if (budget < FRAME_MS - 2) return;
			budget = Math.min(FRAME_MS, budget - FRAME_MS);
			sceneTime += Math.min(0.1, (now - lastFrame) / 1000); // after a long gap (hidden tab), pick up where it left off
			lastFrame = now;
			draw();
		};

		const start = () => {
			if (running || reducedMotion) return;
			running = true;
			lastFrame = lastTick = performance.now();
			budget = 0;
			requestAnimationFrame(frame);
		};

		const resizeObserver = new ResizeObserver(resize);
		resizeObserver.observe(canvas);
		if (reducedMotion) return;

		const visibilityObserver = new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			if (visible) start();
		});
		visibilityObserver.observe(canvas);

		const teardown = () => {
			resizeObserver.disconnect();
			visibilityObserver.disconnect();
			running = false;
		};
		document.addEventListener("astro:after-swap", teardown, { once: true });
	}

	// Runs on first load and after every view-transition navigation
	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll<HTMLCanvasElement>("canvas.builder-grid:not([data-ready])").forEach(mount);
	});
</script>
