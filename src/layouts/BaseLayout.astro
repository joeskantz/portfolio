---
const { title = "My Site" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    	<title>{title}</title>
    	<style>
    		:root {
				--bg: #0f172a;
				--fg: #e5e7eb;
				--accent: #38bdf8;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			body {
				min-height: 100vh;
				background: var(--bg);
				color: var(--fg);
				font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
			}
			nav {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 64px;
				display: flex;
				justify-content: center;
				background: rgba(15, 23, 42, 0.95);
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				z-index: 1000;
			}
			.nav-inner {
				width: 100%;
				max-width: 900px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0 2rem;
			}
			nav a {
				color: var(--fg);
				text-decoration: none;
				font-weight: 500;
			}
			nav a:hover {
				color: var(--accent);
			}
			main {
				min-height: calc(100vh - 64px);
				padding-top: 64px;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<nav>
			<div class="nav-inner">
				<a href="/"> About </a>
				<a href="/projects"> Projects </a>
				<a href="/work"> Work Experience </a>
			</div>
		</nav>
		<main>
			<slot />
		</main>
  	</body>
</html>
