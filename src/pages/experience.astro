---
import BaseLayout from "../layouts/BaseLayout.astro";
import abbvie from "../assets/abbvie.png"; /* Astro optimizes if served from src */
import hntb from "../assets/hntb-logo.png";
import cdis from "../assets/cdis-crest-transparent.png";

// Newest first. Entries with end: "Present" get a highlighted timeline node.
const experiences = [
    {
        company: "UW-Madison College of Computing and Artificial Intelligence",
        role: "Graduate Researcher",
        team: "Prediction-Action Lab (Dr. Josiah Hanna)",
        location: "Madison, WI",
        start: "Mar 2026",
        end: "Present",
        logo: cdis,
        logoBg: "#c5050c", // UW red behind the transparent crest
        bullets: [
            "Member of the BadgerBots <b>Motion Control</b> team (RoboCup).",
            "Autonomous, Multi-Agent Robotic Soccer.",
        ],
        tools: ["MuJoCo Physics Simulation", "Reinforcement Learning", "Python", "PyTorch"],
    },
    {
        company: "AbbVie",
        role: "AI Software Engineer Intern",
        team: "Clinical Artificial Intelligence",
        location: "North Chicago, IL",
        start: "Jan 2025",
        end: "Present",
        logo: abbvie,
        logoFill: true, // logo has its own background; fill the badge edge to edge
        bullets: [
            "<b>2026 Student Impact Award</b>: recognized for project impact within Information Research student/intern cohort.",
            "Proven success taking <b>raw business requirements</b> to <b>production-deployed solution</b>. Contributing to several AI applications within the Clinical Trials space. ",
            "HackVie 2026 runner-up: generalizable, <b>agentic context layer</b> that sits atop domain-specific chatbots to extract more meaningful insights. Earned funding to continue development into Fall 2026!",
            "HackVie 2025 use-case champion: backend for Microsoft Teams AI meeting assistant. Low-latency audio transcription and processing."
        ],
        tools: ["Python", "Docker", "FastAPI", "AWS", "SQLite", "Salesforce (SOQL)", "React", "JavaScript", "Jenkins"],
    },
    {
        company: "HNTB",
        role: "Software Engineer Intern",
        team: "Digital Transformation Solutions",
        location: "Chicago, IL",
        start: "May 2024",
        end: "Aug 2024",
        logo: hntb,
        bullets: [
            "Optimized C# backend systems, including downstream API integrations and database management, and reduced a bulk data upload process from 8 hours to ~2 minutes for millions of data records.",
            "Led requirements-gathering meetings and development of two application POCs that streamline the movement of engineering deliverables between teams, accelerating timelines by several days.",
        ],
        tools: ["C#", "JavaScript", "AWS", "Stakeholder Communication", "Documentation", "Requirements Gathering"],
    },
];
---

<BaseLayout title="Joseph Skantz">

    <div class="layout">
        <h2 class="section-title">Work Experience</h2>

        <ol class="timeline">
            {experiences.map((exp) => {
                const current = exp.end === "Present";
                return (
                    <li class:list={["entry", { current }]}>
                        <div class="date-col">
                            <span class="date-start">{exp.start}</span>
                            <span class="date-end">– {exp.end}</span>
                        </div>
                        <div class="rail-col" aria-hidden="true">
                            <span class="node"></span>
                        </div>
                        <article class="experience-card">
                            <div class="card-top">
                                <div class:list={["logo-badge", { fill: exp.logoFill }]} style={exp.logoBg && `background: ${exp.logoBg}`}>
                                    <img src={exp.logo.src} alt={`${exp.company} logo`} loading="lazy" />
                                </div>
                                <div class="title-block">
                                    <h3 class="role">
                                        <span class="company">{exp.company}</span>
                                        <span class="role-sep">·</span>
                                        <span class="role-title">{exp.role}</span>
                                    </h3>
                                    <p class="team">
                                        <span class="team-name">{exp.team}</span>
                                        <span class="team-sep">|</span>
                                        <span class="location">{exp.location}</span>
                                    </p>
                                </div>
                                <span class="date-pill">{exp.start} – {exp.end}</span>
                            </div>
                            <ul class="bullets">
                                {exp.bullets.map((bullet) => <li set:html={bullet} />)}
                            </ul>
                            <ul class="tools" aria-label="Tools and skills">
                                {exp.tools.map((tool) => <li class="tool-chip">{tool}</li>)}
                            </ul>
                        </article>
                    </li>
                );
            })}
        </ol>
    </div>

    <style>
        .layout {
            width: min(1100px, 100%);
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding-top: 24px;
            padding-bottom: 48px;
        }
        .section-title {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 650;
            letter-spacing: -0.02em;
        }

        /* Timeline: [date] [rail] [card] */
        .timeline {
            --date-w: 120px;
            --rail-w: 20px;
            --col-gap: 14px;
            --node-top: 26px;
            position: relative;
            list-style: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }
        /* Continuous vertical line behind the nodes */
        .timeline::before {
            content: "";
            position: absolute;
            top: var(--node-top);
            bottom: 0;
            left: calc(var(--date-w) + var(--col-gap) + var(--rail-w) / 2 - 1px);
            width: 2px;
            border-radius: 2px;
            background: linear-gradient(to bottom, rgba(56, 189, 248, 0.65), rgba(255, 255, 255, 0.15) 70%, rgba(255, 255, 255, 0));
        }
        .entry {
            display: grid;
            grid-template-columns: var(--date-w) var(--rail-w) 1fr;
            column-gap: var(--col-gap);
            align-items: start;
        }
        .date-col {
            padding-top: calc(var(--node-top) - 6px);
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 2px;
            text-align: right;
        }
        .date-start {
            font-size: 0.92rem;
            font-weight: 650;
            color: rgba(229, 231, 235, 0.94);
        }
        .date-end {
            font-size: 0.82rem;
            color: rgba(229, 231, 235, 0.65);
        }
        .entry.current .date-end {
            color: var(--accent);
        }
        .rail-col {
            position: relative;
            display: flex;
            justify-content: center;
            padding-top: var(--node-top);
        }
        .node {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #0b1020;
            border: 2px solid rgba(255, 255, 255, 0.45);
            box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.35);
            transform: translateY(-50%);
            transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }
        .entry.current .node {
            position: relative;
            background: var(--accent);
            border-color: rgba(186, 230, 253, 0.95);
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.18), 0 0 14px rgba(56, 189, 248, 0.65);
        }
        /* Subtle expanding ring on current roles */
        .entry.current .node::after {
            content: "";
            position: absolute;
            inset: -2px;
            border-radius: 50%;
            border: 2px solid var(--accent);
            opacity: 0;
            animation: node-pulse 1.0s ease-out infinite;
            pointer-events: none;
        }
        @keyframes node-pulse {
            0%   { transform: scale(1);   opacity: 0.45; }
            70%  { transform: scale(2.1); opacity: 0; }
            100% { transform: scale(2.1); opacity: 0; }
        }
        @media (prefers-reduced-motion: reduce) {
            .entry.current .node::after {
                animation: none;
            }
        }
        .entry:hover .node {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.22), 0 0 16px rgba(56, 189, 248, 0.7);
        }

        .experience-card {
            min-width: 0;
            text-align: left;
            padding: 20px;
            border-radius: 24px;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }
        .entry:hover .experience-card {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.45);
            background: rgba(56, 189, 248, 0.10);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
        }
        .card-top {
            display: flex;
            gap: 14px;
            align-items: center;
            min-width: 0;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        /* Small white chip so dark wordmarks stay legible on the glass */
        .logo-badge {
            flex: 0 0 auto;
            box-sizing: border-box;
            width: 84px;
            height: 44px;
            padding: 6px 9px;
            display: flex;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
        }
        .logo-badge img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }
        /* Logo supplies its own background: no white border or backing to bleed through */
        .logo-badge.fill {
            padding: 0;
            overflow: hidden;
            border: none;
            background: none;
        }
        .logo-badge.fill img {
            object-fit: cover;
        }
        .title-block {
            flex: 1;
            min-width: 0;
        }
        .role {
            margin: 0;
            line-height: 1.25;
            letter-spacing: -0.01em;
            font-size: 1.05rem;
            font-weight: 650;
            color: rgba(229, 231, 235, 0.96);
        }
        .company {
            font-weight: 750;
            color: rgba(229, 231, 235, 0.98);
        }
        .role-sep {
            margin: 0 0.4rem;
            opacity: 0.55;
        }
        .role-title {
            font-weight: 600;
            color: rgba(229, 231, 235, 0.86);
        }
        .team {
            margin: 8px 0 0;
            line-height: 1.25;
            letter-spacing: -0.005em;
            font-size: 0.95rem;
            color: rgba(229, 231, 235, 0.82);
        }
        .team-name {
            color: rgba(229, 231, 235, 0.86);
            font-weight: 600;
        }
        .team-sep {
            margin: 0 0.4rem;
            opacity: 0.55;
        }
        .location {
            color: rgba(229, 231, 235, 0.72);
            font-weight: 500;
        }
        .bullets {
            margin: 12px 0 0;
            padding-left: 18px;
            padding-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-size: 0.93rem;
            line-height: 1.45;
            color: rgba(229, 231, 235, 0.86);
        }
        .bullets li {
            overflow-wrap: anywhere;
        }
        /* Bullets render as HTML, so <u>word</u> in a bullet string underlines it */
        .bullets :global(u) {
            text-decoration-color: rgba(56, 189, 248, 0.7);
            text-decoration-thickness: 1.5px;
            text-underline-offset: 3px;
        }
        .bullets li::marker {
            color: rgba(229, 231, 235, 0.55);
        }
        /* Dates live in the timeline column on wide screens; pill is the narrow-screen fallback */
        .date-pill {
            display: none;
            flex: 0 0 auto;
            font-size: 0.85rem;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.12);
            opacity: 0.92;
            white-space: nowrap;
        }
        /* Same divider style as under the card header */
        .tools {
            list-style: none;
            margin: 16px 0 0;
            padding: 14px 0 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .tool-chip {
            font-size: 0.8rem;
            line-height: 1;
            padding: 6px 10px;
            border-radius: 999px;
            color: rgba(229, 231, 235, 0.82);
            background: rgba(0, 0, 0, 0.26);
            border: 1px solid rgba(255, 255, 255, 0.12);
            white-space: nowrap;
            transition: border-color 0.15s ease, color 0.15s ease;
        }
        .entry:hover .tool-chip {
            border-color: rgba(56, 189, 248, 0.35);
            color: rgba(229, 231, 235, 0.95);
        }

        /* Narrow: drop the date column, keep the rail, show the pill */
        @media (max-width: 900px) {
            .timeline {
                --col-gap: 10px;
            }
            .timeline::before {
                left: calc(var(--rail-w) / 2 - 1px);
            }
            .entry {
                grid-template-columns: var(--rail-w) 1fr;
            }
            .date-col {
                display: none;
            }
            .date-pill {
                display: inline-block;
            }
        }
        @media (max-width: 640px) {
            .card-top {
                flex-wrap: wrap;
            }
            /* Drops below the title, lined up with it */
            .date-pill {
                margin-left: calc(84px + 14px);
            }
        }
    </style>

</BaseLayout>
