---
import BaseLayout from "../layouts/BaseLayout.astro";
import abbvie from "../assets/abbvie2.jpg"; /* Astro optimizes if served from src */
import hntb from "../assets/hntb.png";
import cdis from "../assets/cdis.png";
---

<BaseLayout title="Joseph Skantz">

    <div class="layout">
        <h2 class="section-title">Work Experience</h2>

        <article class="experience-card">
                    <div class="experience-grid">
                        <div class="logo-col">
                        <div class="logo-tile" aria-hidden="true">
                            <img src={abbvie.src} alt="AbbVie logo" loading="lazy" />
                        </div>
                        </div>
                        <div class="content-col">
                        <div class="card-top">
                            <div class="title-block">
                                <h3 class="role">
                                    <span class="company">AbbVie</span>
                                    <span class="role-sep">·</span>
                                    <span class="role-title">Software Engineer Intern (AI)</span>
                                </h3>
                                <p class="team">
                                    <span class="team-name">Clinical Artificial Intelligence</span>
                                    <span class="team-sep">|</span>
                                    <span class="location">North Chicago, IL</span>
                                </p>
                            </div>
                            <span class="date-pill">January 2025 – Present</span>
                        </div>
                        <ul class="bullets">
                            <li>Contributing to several internal platforms and AI automations within the Information Research and Clinical Trials space.</li>
                            <li>HackVie 2025 use case champion: developed backend for a Microsoft Teams AI meeting assistant. Leveraged OpenAI's whisper, o4-mini models for real-time audio transcription and processing.</li>
                        </ul>
                        <div class="tools-row">
                            <i class="fa-solid fa-wrench tools-icon" aria-hidden="true"></i>
                            <p class="tools-text">
                                <span class="tools-label">Tools/Skills:</span>
                                <span class="tools-list">Backend Dev, Python, FastAPI, LLMs, Retrieval-Augmented Generation (RAG), Writer Framework</span>
                            </p>
                        </div>
                    </div>
                </div>
                </article>

                <article class="experience-card">
                    <div class="experience-grid">
                        <div class="logo-col">
                        <div class="logo-tile" aria-hidden="true">
                            <img src={cdis.src} alt="CDIS logo" loading="lazy" style="object-position: center 40%;" />
                        </div>
                        </div>
                        <div class="content-col">
                        <div class="card-top">
                            <div class="title-block">
                                <h3 class="role">
                                    <span class="company">UW-Madison Computer Sciences</span>
                                    <span class="role-sep">·</span>
                                    <span class="role-title">Graduate Researcher</span>
                                </h3>
                                <p class="team">
                                    <span class="team-name">Prediction-Action Lab</span>
                                    <span class="team-sep">|</span>
                                    <span class="location">Madison, WI</span>
                                </p>
                            </div>
                            <span class="date-pill">March 2026 – Present</span>
                        </div>
                        <ul class="bullets">
                            <li>Autonomous, Multi-Agent Robotic Soccer</li>
                        </ul>
                        <div class="tools-row">
                            <i class="fa-solid fa-wrench tools-icon" aria-hidden="true"></i>
                            <p class="tools-text">
                                <span class="tools-label">Tools/Skills:</span>
                                <span class="tools-list">ROS2, Reinforcement Learning, Python, Java</span>
                            </p>
                        </div>
                    </div>
                </div>
                </article>

                <article class="experience-card">
                    <div class="experience-grid">
                        <div class="logo-col">
                        <div class="logo-tile" aria-hidden="true">
                            <img src={hntb.src} alt="HNTB logo" loading="lazy" />
                        </div>
                        </div>
                        <div class="content-col">
                        <div class="card-top">
                            <div class="title-block">
                                <h3 class="role">
                                    <span class="company">HNTB</span>
                                    <span class="role-sep">·</span>
                                    <span class="role-title">Software Engineer Intern</span>
                                </h3>
                                <p class="team">
                                    <span class="team-name">Digital Transformation Solutions</span>
                                    <span class="team-sep">|</span>
                                    <span class="location">Chicago, IL</span>
                                </p>
                            </div>
                            <span class="date-pill">May 2024 – August 2024</span>
                        </div>
                        <ul class="bullets">
                            <li>Contributed to the design, full-stack development, maintenance, and technical documentation of various enterprise solutions, both internal and public-facing.</li>
                            <li>Implemented C# backend functionality, including downstream API calls, database management, and optimization of data upload process from 8 hours to ~2 minutes for millions of data records.</li>
                            <li>Led requirements gathering meeting, contributed to the development of two web applications to track and accelerate the flow of internal deliverables.</li>
                        </ul>
                        <div class="tools-row">
                            <i class="fa-solid fa-wrench tools-icon" aria-hidden="true"></i>
                            <p class="tools-text">
                                <span class="tools-label">Tools/Skills:</span>
                                <span class="tools-list">C#, JavaScript, AWS, Stakeholder Communication, Documentation, Requirements Gathering</span>
                            </p>
                        </div>
                    </div>
                </div>
        </article>
    </div>

    <style>
        :global(main) {
            justify-content: flex-start;
            align-items: stretch;
            text-align: left;
            width: 100%;
            padding: var(--page-top) 24px 48px;
        }
        .layout {
            width: min(1100px, 100%);
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding-top: 24px;
            padding-bottom: 48px;
        }
        .section-title {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 650;
            letter-spacing: -0.02em;
        }
        .experience-card {
            text-align: left;
            padding: 20px;
            border-radius: 24px;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }
        .experience-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.45);
            background: rgba(56, 189, 248, 0.10);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
        }
        .experience-grid {
            display: grid;
            grid-template-columns: 1fr 2fr; /* left 1/3, right 2/3 */
            gap: 14px;
            align-items: stretch;
        }
        .logo-col {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .content-col {
            min-width: 0;
            padding-left: 14px;
            border-left: 1px solid rgba(255,255,255,0.08);
        }
        .logo-tile {
            position: relative;
            width: min(220px, 100%);
            aspect-ratio: 2 / 1;
            border-radius: 8px;
            overflow: hidden;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
            /* border: 0.25px solid rgba(255, 255, 255, 0.10); */
            transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
        }
        .logo-tile img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: drop-shadow(0 6px 18px rgba(0,0,0,0.35));
        }
        .card-content {
            min-width: 0;
        }
        .card-top {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: flex-start;
            margin-bottom: 10px;
            min-width: 0;
        }
        .title-block {
            min-width: 0;
        }
        .role {
            margin: 0;
            line-height: 1.25;
            letter-spacing: -0.01em;
            font-size: 1.05rem;
            font-weight: 650;
            color: rgba(229, 231, 235, 0.96);
        }
        .company {
            font-weight: 750;
            color: rgba(229, 231, 235, 0.98);
        }
        .role-sep {
            margin: 0 0.4rem;
            opacity: 0.55;
        }
        .role-title {
            font-weight: 600;
            color: rgba(229, 231, 235, 0.86);
        }
        .team {
            margin: 8px 0 0;
            line-height: 1.25;
            letter-spacing: -0.005em;
            font-size: 0.95rem;
            color: rgba(229, 231, 235, 0.82);
        }
        .team-name {
            color: rgba(229, 231, 235, 0.86);
            font-weight: 600;
        }
        .team-sep {
            margin: 0 0.4rem;
            opacity: 0.55;
        }
        .location {
            color: rgba(229, 231, 235, 0.72);
            font-weight: 500;
        }
        .bullets {
            margin: 12px 0 0;
            padding-left: 18px;
            padding-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-size: 0.93rem;
            line-height: 1.45;
            color: rgba(229, 231, 235, 0.86);
        }
        .bullets li {
            overflow-wrap: anywhere;
        }
        .bullets li::marker {
            color: rgba(229, 231, 235, 0.55);
        }
        .date-pill {
            flex: 0 0 auto;
            font-size: 0.85rem;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.12);
            opacity: 0.92;
            white-space: nowrap;
        }
        .tools-text {
            margin: 0;
            font-size: 0.9rem;
            line-height: 1.35;
            color: rgba(229, 231, 235, 0.82);
            min-width: 0;        
        }
        .tools-row {
            padding-top: 7px;
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }
        .tools-label {
            font-weight: 650;
            color: rgba(229, 231, 235, 0.90);
        }
        .tools-list {
            color: rgba(229, 231, 235, 0.78);
        }
        .tools-icon {
            width: 16px;
            height: 16px;
            opacity: 0.85;
            flex: 0 0 auto;
            filter: drop-shadow(0 6px 14px rgba(0,0,0,0.35));
        }
        @media (max-width: 640px) {
            .card-top {
                flex-direction: column;
                align-items: flex-start;
            }
            .date-pill {
                margin-top: 6px;
            }
        }
    </style>

</BaseLayout>
