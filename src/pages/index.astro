---
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/headshot.png";
import CoffeeCupGrid from "../components/CoffeeCupGrid.astro";

// Coursework card, one column per semester. An empty courses list shows "TBD".
const semesters = [
    {
        label: "Spring '26",
        courses: [
            { code: "CS 759", name: "High Performance Computing for Applications in Engineering" },
            { code: "CS 760", name: "Machine Learning" },
            { code: "CS 532", name: "Matrix Methods in Machine Learning" }
        ],
    },
    {
        label: "Fall '26",
        courses: [
            { code: "CS 839", name: "Advanced Topics in Reinforcement Learning" },
            { code: "CS 639", name: "Systems Architecture for Quantum Computers" },
            { code: "CS 771", name: "Learning-Based Methods for Computer Vision" }
        ],
    },
    {
        label: "Spring '27",
        courses: [],
    },
];
---

<BaseLayout title="Joseph Skantz">
    <div class="layout">
        <div class="identity-card">
            <div class="headshot-wrapper">
                <img src={headshot.src} class="headshot"/>
            </div>
            <h1 class="name">Joseph Skantz</h1>
            <h3 class="education-h3">University of Wisconsin-Madison</h3>
            <p class="education-p">M.S. Computer Science <span class="muted">(Jan. 2026 - May 2027)</span></p>
            <p class="education-sub">Focus: Machine Learning Systems Engineering</p>
            <p class="education-p">B.S. Computer Science <span class="muted">(Sep. 2021 - Dec. 2025)</span></p>
            <div class="social-row" aria-label="social links">
                <a class="icon-link" href="https://www.linkedin.com/in/josephskantz/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
                    <img src="/linkedin.svg" alt="" />
                </a>
                <a class="icon-link" href="https://github.com/joeskantz" target="_blank" rel="noreferrer" aria-label="GitHub">
                    <img src="/github.svg" alt="" />
                </a>
            </div>
        </div>
        <div class="glass-container">
            <div class="projects">
                <h2 class="section-title">Featured Projects</h2>

                <a class="project-card" href="/projects/recommender">
                <div class="project-image">
                    <img src="/recommender-tail-latency.png" alt="HPC recommender — tail latency vs request rate" loading="lazy" />
                </div>
                <div class="project-text">
                    <h3>HPC-Accelerated Music Recommender</h3>
                    <p>ML pipeline (Matrix Factorization). CUDA + cuBLAS training/inference, benchmarked against CPU baselines.</p>
                </div>
                </a>

                <a class="project-card" href="/projects/gpt2-from-scratch">
                <div class="project-image">
                    <img src="/gpt2-from-scratch.png" alt="GPT-2 from scratch" loading="lazy" />
                </div>
                <div class="project-text">
                    <h3>GPT-2 From Scratch</h3>
                    <p>PyTorch GPT-2: hand-built attention and transformer blocks, verified to token-level parity with HuggingFace's reference.</p>
                </div>
                </a>

                <a class="project-card" href="/projects">
                <div class="project-image">
                    <CoffeeCupGrid />
                </div>
                <div class="project-text">
                    <h3>More coming soon...</h3>
                </div>
                </a>

            </div>
        </div>
    </div>
    <div class="coursework-card">
        <h2 class="section-title">Recent Coursework</h2>

        <div class="semester-grid">
            {semesters.map((semester) => (
                <section class="semester">
                    <h3>{semester.label}</h3>
                    {semester.courses.length > 0 ? (
                        <ul class="course-list">
                            {semester.courses.map((course) => (
                                <li>
                                    <span class="course-code">{course.code}</span>
                                    <span>{course.name}</span>
                                </li>
                            ))}
                        </ul>
                    ) : (
                        <p class="course-tbd">TBD</p>
                    )}
                </section>
            ))}
        </div>
    </div>

    <style>
        /* Matches the section titles on the Projects and Experience pages */
        .section-title {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 650;
            letter-spacing: -0.02em;
        }
        /* Two-column layout */
        .layout {
            width: min(1100px, 100%);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 400px 1fr; /* left fixed, right fluid */
            gap: 18px;
            align-items: stretch; /* both cards share the taller card's height */
        }

        /* Left side: identity card */
        .identity-card {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border-radius: 30px;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            /* border: 1px solid rgba(255, 255, 255, 0.15); */
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
            z-index: 2;
        }
		.headshot-wrapper {
			width: 160px;
            aspect-ratio: 1/1;
			border-radius: 50%;
			overflow: hidden;
			border: 3px solid #ffffffff;
		}
		.headshot-wrapper img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center 40%;
			transform: scale(1.50);
		}
        .name {
			margin: 0;
			font-size: 1.6rem;
			font-weight: 650;
			letter-spacing: -0.02em;
		}
        .muted {
            opacity: 0.78;
        }
        .education-sub {
            margin: 1px 0 0;
            font-size: 0.9rem;
            line-height: 1.25;
            color: rgba(229, 231, 235, 0.82);
        }
        .education-p {
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.25;
        }
        .education-h3 {
            padding-top: 30px;
            margin: 0;
            font-size: 1.15rem;
        }
        .social-row {
            margin-top: 50px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }
        .icon-link {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: rgba(229, 231, 235, 0.92);
            background: rgba(0, 0, 0, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }
        .icon-link:hover {
            transform: translateY(-1px);
            background: rgba(56, 189, 248, 0.12);
            /* border-color: rgba(56, 189, 248, 0.45); */
            color: var(--accent);
        }
        .icon-link img {
            width: 20px;
            height: 20px;
            display: block;
        }

        /* Right Side: projects container*/
        .glass-container {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1rem 1.25rem;
			border-radius: 30px;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
			backdrop-filter: blur(5px);
			-webkit-backdrop-filter: blur(5px);
			/* border: 1px solid rgba(255, 255, 255, 0.15); */
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
			z-index: 2;
		}
        .projects {
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex: 1;
            min-width: 0;
        }
        .project-card {
            display: flex;
            gap: 12px;
            align-items: stretch;
            padding: 10px 12px;
            border-radius: 18px;
            text-decoration: none;
            color: inherit;
            background: rgba(0, 0, 0, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
        }
        .project-card:hover {
            transform: translateY(-1px);
            border-color: rgba(56, 189, 248, 0.45);
            background: rgba(56, 189, 248, 0.10);
        }
        .project-image {
            width: 220px;
            height: 144px;
            border-radius: 12px;
            overflow: hidden;
            flex: 0 0 auto;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .project-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .project-text {
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 4px;
        }
        .project-text h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 650;
        }
        .project-text p {
            margin: 0;
            font-size: 0.9rem;
            opacity: 0.9;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Below both columns: coursework by semester */
        .coursework-card {
            box-sizing: border-box;
            width: min(1100px, 100%);
            margin: 18px auto 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: 1rem 1.25rem;
            border-radius: 30px;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
            z-index: 2;
        }
        .semester-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            align-items: start;
        }
        .semester {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }
        .semester h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 650;
        }
        .course-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        /* Code and name side by side, so wrapped names stay indented past the code */
        .course-list li {
            display: flex;
            align-items: baseline;
            padding: 8px 12px;
            border-radius: 14px;
            font-size: 0.9rem;
            background: rgba(0, 0, 0, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .course-code {
            flex: 0 0 auto;
            margin-right: 8px;
            font-weight: 600;
            color: var(--accent);
        }
        .course-tbd {
            margin: 0;
            padding: 8px 12px;
            border-radius: 14px;
            font-size: 0.9rem;
            color: rgba(229, 231, 235, 0.6);
            border: 1px dashed rgba(255, 255, 255, 0.18);
        }

        @media (max-width: 900px) {
            .layout {
                grid-template-columns: 1fr;
            }
            .semester-grid {
                grid-template-columns: 1fr;
            }
        }
        /* Phones: image above text so titles and descriptions get the full card width */
        @media (max-width: 700px) {
            .project-card {
                flex-direction: column;
            }
            .project-image {
                width: 100%;
                height: auto;
                aspect-ratio: 220 / 144;
            }
        }
	</style>
</BaseLayout>