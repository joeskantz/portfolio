---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Joseph Skantz — Personal Projects">
    <div class="layout">
        <h2 class="section-title">Personal Projects</h2>

        <div class="projects">
            <article class="project-card">
                <div class="project-image">
                    <img src="/recommender-tail-latency.png" alt="HPC recommender — tail latency vs request rate" loading="lazy" />
                </div>
                <div class="project-text">
                    <h3>
                        <a class="project-title-link" href="/projects/recommender">HPC-Accelerated Music Recommender</a>
                    </h3>
                    <p class="meta">CUDA · cuBLAS · OpenBLAS · OpenMP · C++ · Python</p>
                    <p>
                        Matrix-factorization recommender for ~120K users and ~5.6M tracks from the Last.fm
                        LFM-1b dataset. Both training and inference are implemented as a CPU baseline and a
                        GPU-accelerated path, with end-to-end benchmarks on training wall-clock and tail latency.
                    </p>
                    <div class="card-actions">
                        <a class="repo-pill" href="https://github.com/joeskantz/recommender" target="_blank" rel="noreferrer">
                            <i class="fa-brands fa-github" aria-hidden="true"></i>
                            <span>View on GitHub</span>
                        </a>
                    </div>
                </div>
            </article>

            <div class="placeholder-card" aria-hidden="true">
                <p>More projects coming soon...</p>
            </div>
        </div>
    </div>

    <style>
        :global(main) {
            justify-content: flex-start;
            align-items: stretch;
            text-align: left;
            width: 100%;
            padding: var(--page-top) 24px 48px;
        }
        .layout {
            width: min(1100px, 100%);
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding-top: 24px;
            padding-bottom: 48px;
        }
        .section-title {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 650;
            letter-spacing: -0.02em;
        }
        .projects {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .project-card {
            position: relative;
            display: flex;
            gap: 16px;
            align-items: stretch;
            padding: 16px;
            border-radius: 24px;
            text-decoration: none;
            color: inherit;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), rgba(255,255,255,0.00) 55%);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
            transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }
        .project-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.45);
            background: rgba(56, 189, 248, 0.10);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
        }
        .project-title-link {
            color: inherit;
            text-decoration: none;
        }
        .project-title-link::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            z-index: 1;
        }
        .card-actions {
            position: absolute;
            top: 16px;
            right: 16px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .repo-pill {
            position: relative;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            padding: 6px 12px;
            border-radius: 999px;
            text-decoration: none;
            color: rgba(229, 231, 235, 0.92);
            background: rgba(0, 0, 0, 0.30);
            border: 1px solid rgba(255, 255, 255, 0.14);
            transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
            white-space: nowrap;
        }
        .repo-pill:hover {
            transform: translateY(-1px);
            color: var(--accent);
            border-color: rgba(56, 189, 248, 0.55);
            background: rgba(56, 189, 248, 0.14);
        }
        .project-image {
            width: 280px;
            min-height: 170px;
            border-radius: 14px;
            overflow: hidden;
            flex: 0 0 auto;
            border: 1px solid rgba(255, 255, 255, 0.10);
            background: rgba(255, 255, 255, 0.96);
        }
        .project-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .project-text {
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
        }
        .project-text h3 {
            margin: 0;
            padding-right: 150px;
            font-size: 1.1rem;
            font-weight: 650;
            letter-spacing: -0.01em;
        }
        .project-text p {
            margin: 0;
            font-size: 0.93rem;
            line-height: 1.5;
            color: rgba(229, 231, 235, 0.86);
        }
        .project-text p.meta {
            font-size: 0.82rem;
            color: rgba(229, 231, 235, 0.70);
            letter-spacing: 0.01em;
        }
        .placeholder-card {
            padding: 18px 20px;
            border-radius: 24px;
            border: 1px dashed rgba(255, 255, 255, 0.18);
            background: rgba(0, 0, 0, 0.18);
            color: rgba(229, 231, 235, 0.65);
            text-align: center;
        }
        .placeholder-card p {
            margin: 0;
            font-size: 0.95rem;
        }
        @media (max-width: 700px) {
            .project-card {
                flex-direction: column;
            }
            .project-image {
                width: 100%;
                min-height: 200px;
            }
        }
    </style>
</BaseLayout>
